# Python bytecode and tool caches
__pycache__/
*.py[cod]
.coverage
.coverage.*
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/

# Local environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets and local configuration
.env
.env.*
!.env.example

# Private datasets and images
data/
dataset/
datasets/
images/
*.bmp
*.gif
*.jpeg
*.jpg
*.png
*.tif
*.tiff
*.webp
!fixtures/*

# Compressed archives (datasets, releases)
*.7z
*.rar
*.tar
*.tar.gz
*.zip

# Checkpoints, weights, and exported models
checkpoints/
models/*
weights/
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.tflite
*.torchscript

# Generated experiment and inference output
outputs/
runs/
artifacts/
mlruns/

# Deployment model (versioned exception for server deploys)
!models/deploy/
!models/deploy/*.pt
